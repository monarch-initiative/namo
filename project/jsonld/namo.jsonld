        "dataset__model_systems",
        "dataset__studies"
      ],
      "slot_usage": {},
      "attributes": [
        {
          "name": "model_systems",
          "range": "ModelSystem",
          "multivalued": true,
          "inlined_as_list": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "studies",
