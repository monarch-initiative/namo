    },
    {
      "name": "NamedThing",
      "definition_uri": "https://w3id.org/monarch-initiative/namo/NamedThing",
      "description": "A generic grouping for any identifiable entity",
      "from_schema": "https://w3id.org/monarch-initiative/namo",
      "mappings": [
        "schema:Thing"
      ],
      "slots": [
        "id",
        "name",
        "description",
        "type"
      ],
      "slot_usage": {},
      "class_uri": "http://schema.org/Thing",
      "@type": "ClassDefinition"
    },
    {
      "name": "Study",
      "definition_uri": "https://w3id.org/monarch-initiative/namo/Study",
      "description": "A study is a structured investigation or analysis, often involving the collection and interpretation of data, to answer specific research questions or test hypotheses.",
      "from_schema": "https://w3id.org/monarch-initiative/namo",
      "see_also": [
        "https://www.oecd.org/chemicalsafety/testing/",
        "https://doi.org/10.1371/journal.pbio.3000410"
      ],
      "exact_mappings": [
        "OECD:OHT210_study",
        "ARRIVE:in_vivo_experiment"
      ],
      "is_a": "NamedThing",
      "slots": [
        "id",
        "name",
        "description",
        "type",
        "study__context_of_use",
        "study__biological_context",
        "study__perturbations",
        "study__endpoints",
        "study__plan_comparators"
      ],
      "slot_usage": {},
      "attributes": [
        {
          "name": "context_of_use",
          "description": "What decision will this inform? Care? Policy? Drug approval?",
          "@type": "SlotDefinition"
        },
        {
          "name": "biological_context",
          "description": "tissue/region (anatomy), cell types, sex/age equivalents, mechanics (e.g., cyclic stretch), microenvironment",
          "@type": "SlotDefinition"
        },
        {
          "name": "perturbations",
          "description": "exposure/dose/time; diet/drugs/toxicants",
          "@type": "SlotDefinition"
        },
        {
          "name": "endpoints",
          "description": "phenotypes, function (TEER/leak, beating rate), and multi-omics",
          "@type": "SlotDefinition"
        },
        {
          "name": "plan_comparators",
          "description": "human data, gold-standard assays, or high-quality animal references",
          "@type": "SlotDefinition"
        }
      ],
      "class_uri": "https://w3id.org/monarch-initiative/namo/Study",
      "@type": "ClassDefinition"
    },
    {
      "name": "ModelSystem",
      "definition_uri": "https://w3id.org/monarch-initiative/namo/ModelSystem",
      "from_schema": "https://w3id.org/monarch-initiative/namo",
      "is_a": "NamedThing",
      "abstract": true,
      "slots": [
        "id",
        "name",
        "description",
        "type",
        "modelSystem__models"
      ],
      "slot_usage": {},
      "attributes": [
        {
          "name": "models",
          "range": "ModelsRelationship",
          "multivalued": true,
          "@type": "SlotDefinition"
        }
      ],
      "class_uri": "https://w3id.org/monarch-initiative/namo/ModelSystem",
      "@type": "ClassDefinition"
    },
    {
      "name": "AnimalModel",
      "definition_uri": "https://w3id.org/monarch-initiative/namo/AnimalModel",
      "from_schema": "https://w3id.org/monarch-initiative/namo",
      "see_also": [
        "https://doi.org/10.1371/journal.pbio.3000410"
      ],
      "exact_mappings": [
        "ARRIVE:animal_model"
      ],
      "is_a": "ModelSystem",
      "slots": [
        "id",
        "name",
        "description",
        "type",
        "modelSystem__models",
        "animalModel__species",
        "animalModel__strain",
        "animalModel__life_stage",
        "animalModel__age_value",
        "animalModel__environment"
      ],
      "slot_usage": {},
      "attributes": [
        {
          "name": "species",
          "description": "The species of the animal used in the model system.",
          "range": "OrganismTaxon",
          "bindings": [
            {
              "range": "SpeciesEnum",
              "obligation_level": "REQUIRED",
              "binds_value_of": "id",
              "@type": "EnumBinding"
            }
          ],
          "required": true,
          "inlined": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "strain",
          "description": "The specific strain of the animal used in the model system.",
          "range": "OrganismTaxon",
          "bindings": [
            {
              "range": "StrainEnum",
              "obligation_level": "REQUIRED",
              "binds_value_of": "id",
              "@type": "EnumBinding"
            }
          ],
          "inlined": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "life_stage",
          "description": "The developmental or life-cycle stage of the animal used in the model system.",
          "range": "LifeStage",
          "inlined": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "age_value",
          "description": "Chronological age of the animal at the time of study, as a numeric value with a unit.",
          "range": "QuantityValue",
          "inlined": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "environment",
          "description": "The environmental conditions under which the animal model is maintained.",
          "range": "EnvironmentalExposure",
          "inlined": true,
          "@type": "SlotDefinition"
        }
      ],
      "class_uri": "https://w3id.org/monarch-initiative/namo/AnimalModel",
      "@type": "ClassDefinition"
    },
    {
      "name": "NAMModel",
      "definition_uri": "https://w3id.org/monarch-initiative/namo/NAMModel",
      "description": "A New Approach Methodology (NAM) model, which is a type of model system that does not involve the use of animals.",
      "from_schema": "https://w3id.org/monarch-initiative/namo",
      "see_also": [
        "https://doi.org/10.14573/altex.2501011"
      ],
      "exact_mappings": [
        "GIVReST:in_vitro_model",
        "OECD:new_approach_methodology"
      ],
      "is_a": "ModelSystem",
      "abstract": true,
      "slots": [
        "id",
        "name",
        "description",
        "type",
        "modelSystem__models",
        "nAMModel__biological_organization_level",
        "nAMModel__spatial_context",
        "nAMModel__complexity_level",
        "nAMModel__references"
      ],
      "slot_usage": {},
      "attributes": [
        {
          "name": "biological_organization_level",
          "description": "The level of biological organization represented by the model",
          "range": "BiologicalOrganizationLevelEnum",
          "@type": "SlotDefinition"
        },
        {
          "name": "spatial_context",
          "description": "Description of spatial organization and context captured by the model",
          "@type": "SlotDefinition"
        },
        {
          "name": "complexity_level",
          "description": "Level of biological complexity represented (subcellular, cellular, tissue, organ, system)",
          "range": "ComplexityLevelEnum",
          "@type": "SlotDefinition"
        },
        {
          "name": "references",
          "description": "Literature references that describe, validate, or support this model",
          "range": "Reference",
          "multivalued": true,
          "inlined_as_list": true,
          "@type": "SlotDefinition"
        }
      ],
      "class_uri": "https://w3id.org/monarch-initiative/namo/NAMModel",
      "@type": "ClassDefinition"
    },
    {
      "name": "CellularSystem",
      "definition_uri": "https://w3id.org/monarch-initiative/namo/CellularSystem",
      "description": "Cell-based model systems that use living cells to model biological processes. Includes 2D cultures, 3D systems, and co-cultures. Conforms to MIACA (Minimal Information About a Cellular Assay) standards.",
      "from_schema": "https://w3id.org/monarch-initiative/namo",
      "see_also": [
        "https://doi.org/10.5966/sctm.2015-0393"
      ],
      "exact_mappings": [
        "MIACA:cellular_assay"
      ],
      "is_a": "NAMModel",
      "abstract": true,
      "slots": [
        "id",
        "name",
        "description",
        "type",
        "modelSystem__models",
        "nAMModel__biological_organization_level",
        "nAMModel__spatial_context",
        "nAMModel__complexity_level",
        "nAMModel__references",
        "cellularSystem__cell_types",
        "cellularSystem__cell_source",
        "cellularSystem__culture_conditions"
      ],
      "slot_usage": {},
      "attributes": [
