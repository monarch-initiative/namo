    skos:inScheme <https://w3id.org/monarch-initiative/namo> .

namo:personalization_parameters a owl:DatatypeProperty ;
    rdfs:label "personalization_parameters" ;
    skos:definition "Parameters used for personalization (genetic, phenotypic, etc.)" ;
    skos:inScheme <https://w3id.org/monarch-initiative/namo> .

namo:quality_control_metrics a owl:ObjectProperty ;
    rdfs:label "quality_control_metrics" ;
    skos:definition "List of quality control measures and their values." ;
    skos:inScheme <https://w3id.org/monarch-initiative/namo> .

namo:real_time_data_sources a owl:DatatypeProperty ;
    rdfs:label "real_time_data_sources" ;
    skos:definition "Sources of real-time data for model updating" ;
    skos:inScheme <https://w3id.org/monarch-initiative/namo> .

namo:references a owl:ObjectProperty ;
    rdfs:label "references" ;
    skos:definition "Literature references that describe, validate, or support this model" ;
    skos:inScheme <https://w3id.org/monarch-initiative/namo> .

namo:represented_cell_types a owl:ObjectProperty ;
