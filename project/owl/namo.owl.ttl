            owl:onProperty namo:pka ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty namo:molecular_weight ],
        linkml:ClassDefinition ;
    skos:definition "Physicochemical and pharmacological properties of a drug in PBPK models." ;
    skos:inScheme <https://w3id.org/monarch-initiative/namo> .

namo:EnrichmentStatistics a owl:Class ;
    rdfs:label "EnrichmentStatistics" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom xsd:float ;
            owl:onProperty namo:p_value ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:integer ;
            owl:onProperty namo:genes_in_dataset ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty namo:genes_in_dataset ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty namo:genes_in_pathway ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty namo:enrichment_score ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty namo:genes_in_dataset ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty namo:genes_in_pathway ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty namo:p_value ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:float ;
            owl:onProperty namo:q_value ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty namo:q_value ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty namo:p_value ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:float ;
            owl:onProperty namo:enrichment_score ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty namo:enrichment_score ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:integer ;
            owl:onProperty namo:genes_in_pathway ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty namo:q_value ],
        linkml:ClassDefinition ;
    skos:definition "Statistical measures for pathway enrichment analysis." ;
    skos:inScheme <https://w3id.org/monarch-initiative/namo> .

namo:ModelPerformance a owl:Class ;
    rdfs:label "ModelPerformance" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom xsd:float ;
            owl:onProperty namo:auc ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty namo:r_squared ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty namo:specificity ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty namo:specificity ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty namo:accuracy ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty namo:sensitivity ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:float ;
            owl:onProperty namo:sensitivity ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty namo:rmse ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty namo:auc ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty namo:r_squared ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty namo:accuracy ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:float ;
            owl:onProperty namo:accuracy ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:float ;
            owl:onProperty namo:rmse ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:float ;
            owl:onProperty namo:specificity ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty namo:rmse ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:float ;
            owl:onProperty namo:r_squared ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty namo:sensitivity ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty namo:auc ],
        linkml:ClassDefinition ;
    skos:definition "Statistical performance metrics for computational models." ;
    skos:inScheme <https://w3id.org/monarch-initiative/namo> .

namo:ModelsRelationship a owl:Class ;
    rdfs:label "ModelsRelationship" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom xsd:boolean ;
            owl:onProperty namo:is_computed ],
        [ a owl:Restriction ;
            owl:allValuesFrom namo:BiologicalSystem ;
            owl:onProperty namo:biological_system_modeled ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty namo:structured_concordance ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty namo:biological_system_modeled ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty namo:concordance ],
        [ a owl:Restriction ;
            owl:allValuesFrom namo:StructuredConcordanceResult ;
            owl:onProperty namo:structured_concordance ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty namo:structured_concordance ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty namo:is_computed ],
        [ a owl:Restriction ;
            owl:allValuesFrom namo:ConcordanceResult ;
            owl:onProperty namo:concordance ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty namo:is_computed ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty namo:concordance ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty namo:biological_system_modeled ],
        linkml:ClassDefinition ;
    skos:inScheme <https://w3id.org/monarch-initiative/namo> .

namo:QualityControlMetric a owl:Class ;
    rdfs:label "QualityControlMetric" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom xsd:boolean ;
            owl:onProperty namo:pass_fail_status ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:float ;
            owl:onProperty namo:metric_value ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty namo:metric_value ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty namo:threshold ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty namo:metric_name ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty namo:metric_value ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty namo:metric_name ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:float ;
            owl:onProperty namo:threshold ],
        [ a owl:Restriction ;
