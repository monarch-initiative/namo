            owl:onProperty namo:anatomical_structure_modeled ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty namo:barrier_functions ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty namo:tissue_architecture ],
        namo:MicrophysiologicalSystem ;
    skos:definition "Tissue-level microphysiological systems that model specific tissue functions and multi-cellular interactions. Aligned with ISO 10991:2023 microfluidics terminology." ;
    skos:exactMatch ISO10991:tissue_on_chip ;
    skos:inScheme <https://w3id.org/monarch-initiative/namo> .

