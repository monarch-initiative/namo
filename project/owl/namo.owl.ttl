    skos:inScheme <https://w3id.org/monarch-initiative/namo> .

namo:interface_type a owl:ObjectProperty ;
    rdfs:label "interface_type" ;
    skos:definition "Type of interface(s) present in the device" ;
    skos:inScheme <https://w3id.org/monarch-initiative/namo> .

namo:material a owl:ObjectProperty ;
    rdfs:label "material" ;
    skos:definition "Materials used to construct the device" ;
    skos:inScheme <https://w3id.org/monarch-initiative/namo> .

namo:missing_cell_types a owl:ObjectProperty ;
    rdfs:label "missing_cell_types" ;
    skos:definition "List of cell types present in biological system but missing in model." ;
    skos:inScheme <https://w3id.org/monarch-initiative/namo> .

namo:model_specific_phenotypes a owl:ObjectProperty ;
    rdfs:label "model_specific_phenotypes" ;
    skos:definition "List of phenotypes present only in the model system." ;
    skos:inScheme <https://w3id.org/monarch-initiative/namo> .

namo:model_systems a owl:ObjectProperty ;
    rdfs:label "model_systems" ;
    skos:inScheme <https://w3id.org/monarch-initiative/namo> .

namo:models a owl:ObjectProperty ;
    rdfs:label "models" ;
    skos:inScheme <https://w3id.org/monarch-initiative/namo> .

namo:molecular_descriptors a owl:DatatypeProperty ;
    rdfs:label "molecular_descriptors" ;
