@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema1: <http://schema.org/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

namo:AnatomicalStructureEnum a owl:Class ;
    rdfs:label "AnatomicalStructureEnum" ;
    rdfs:subClassOf linkml:EnumDefinition ;
    skos:definition "Multicellular anatomical structures — organs, tissues, tracts and barriers alike. Rooted at the term Biolink's `gross anatomical structure` maps to." ;
    skos:inScheme <https://w3id.org/monarch-initiative/namo> .

namo:CellTypeEnum a owl:Class ;
    rdfs:label "CellTypeEnum" ;
    rdfs:subClassOf linkml:EnumDefinition ;
    skos:inScheme <https://w3id.org/monarch-initiative/namo> .

namo:Dataset a owl:Class ;
    rdfs:label "Dataset" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty namo:model_systems ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty namo:studies ],
        [ a owl:Restriction ;
            owl:allValuesFrom namo:Study ;
            owl:onProperty namo:studies ],
        [ a owl:Restriction ;
            owl:allValuesFrom namo:ModelSystem ;
            owl:onProperty namo:model_systems ],
        linkml:ClassDefinition ;
    skos:inScheme <https://w3id.org/monarch-initiative/namo> .

namo:InvestigativeProtocolEnum a owl:Class ;
    rdfs:label "InvestigativeProtocolEnum" ;
    rdfs:subClassOf linkml:EnumDefinition ;
    skos:inScheme <https://w3id.org/monarch-initiative/namo> .

namo:LifeStageEnum a owl:Class ;
    rdfs:label "LifeStageEnum" ;
    rdfs:subClassOf linkml:EnumDefinition ;
    skos:definition "Developmental and life-cycle stages. Composed rather than rooted at UBERON:0000105 alone: the species-specific developmental ontologies are not asserted as subclasses of it (MmusDv:0000110 has MmusDv:0000000 as its only ontology ancestor), so a UBERON-only root would reject the species-specific terms Biolink's `life stage` lists in its id_prefixes." ;
    skos:inScheme <https://w3id.org/monarch-initiative/namo> .

namo:OrganEnum a owl:Class ;
    rdfs:label "OrganEnum" ;
    rdfs:subClassOf linkml:EnumDefinition ;
    skos:inScheme <https://w3id.org/monarch-initiative/namo> .

namo:PhenotypeEnum a owl:Class ;
    rdfs:label "PhenotypeEnum" ;
    rdfs:subClassOf linkml:EnumDefinition ;
    skos:definition "Phenotypic abnormalities across the human and mammalian phenotype ontologies, matching the span of Biolink's `phenotypic feature`." ;
    skos:inScheme <https://w3id.org/monarch-initiative/namo> .

namo:SampleProcessingEnum a owl:Class ;
    rdfs:label "SampleProcessingEnum" ;
    rdfs:subClassOf linkml:EnumDefinition ;
    skos:inScheme <https://w3id.org/monarch-initiative/namo> .

namo:SpeciesEnum a owl:Class ;
    rdfs:label "SpeciesEnum" ;
    rdfs:subClassOf linkml:EnumDefinition ;
    skos:inScheme <https://w3id.org/monarch-initiative/namo> .

namo:StudyDesignEnum a owl:Class ;
    rdfs:label "StudyDesignEnum" ;
    rdfs:subClassOf linkml:EnumDefinition ;
    skos:inScheme <https://w3id.org/monarch-initiative/namo> .

namo:CellRatio a owl:Class ;
    rdfs:label "CellRatio" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty namo:ratio_type ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty namo:ratio ],
        [ a owl:Restriction ;
            owl:allValuesFrom namo:Cell ;
            owl:onProperty namo:cell_type ],
        [ a owl:Restriction ;
            owl:allValuesFrom namo:RatioTypeEnum ;
            owl:onProperty namo:ratio_type ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty namo:ratio ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty namo:ratio_type ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty namo:cell_type ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty namo:cell_type ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:float ;
            owl:onProperty namo:ratio ],
        linkml:ClassDefinition ;
    skos:definition "Ratio specification for different cell types in co-culture systems." ;
    skos:inScheme <https://w3id.org/monarch-initiative/namo> .

namo:CellTypeProportion a owl:Class ;
    rdfs:label "CellTypeProportion" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom xsd:float ;
            owl:onProperty namo:biological_proportion ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:float ;
            owl:onProperty namo:proportion_ratio ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty namo:biological_proportion ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty namo:model_proportion ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:float ;
            owl:onProperty namo:model_proportion ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty namo:cell_type ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty namo:biological_proportion ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty namo:proportion_ratio ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty namo:model_proportion ],
        [ a owl:Restriction ;
            owl:allValuesFrom namo:Cell ;
            owl:onProperty namo:cell_type ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty namo:cell_type ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty namo:proportion_ratio ],
        linkml:ClassDefinition ;
    skos:definition "Quantitative comparison of cell type proportions between systems." ;
    skos:inScheme <https://w3id.org/monarch-initiative/namo> .

namo:ChannelDimensions a owl:Class ;
    rdfs:label "ChannelDimensions" ;
    rdfs:seeAlso <https://www.iso.org/standard/82146.html> ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom xsd:float ;
            owl:onProperty namo:width ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty namo:width ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:float ;
            owl:onProperty namo:height ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:float ;
            owl:onProperty namo:length ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty namo:length ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty namo:channel_name ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty namo:height ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty namo:width ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty namo:height ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty namo:length ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty namo:channel_name ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty namo:channel_name ],
        linkml:ClassDefinition ;
    skos:definition "Dimensions of a microfluidic channel according to ISO 10991:2023 definitions for microchannel geometry and dimensions" ;
    skos:exactMatch ISO10991:microchannel ;
    skos:inScheme <https://w3id.org/monarch-initiative/namo> .

namo:ConcordanceResult a owl:Class ;
    rdfs:label "ConcordanceResult" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty namo:phenotype_overlap ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty namo:pathway_concordance ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty namo:functional_parity ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty namo:functional_parity ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty namo:cell_type_coverage ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty namo:pathway_concordance ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty namo:functional_parity ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty namo:cell_type_coverage ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty namo:reproducibility ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty namo:cell_type_coverage ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty namo:reproducibility ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty namo:phenotype_overlap ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty namo:molecular_similarity ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty namo:phenotype_overlap ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty namo:reproducibility ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty namo:molecular_similarity ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty namo:pathway_concordance ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty namo:molecular_similarity ],
        linkml:ClassDefinition ;
    skos:inScheme <https://w3id.org/monarch-initiative/namo> .

namo:CrossValidation a owl:Class ;
    rdfs:label "CrossValidation" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty namo:n_folds ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:float ;
            owl:onProperty namo:cv_std ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty namo:cv_score ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty namo:cv_method ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty namo:cv_std ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty namo:n_folds ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:float ;
            owl:onProperty namo:cv_score ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty namo:cv_method ],
        [ a owl:Restriction ;
            owl:allValuesFrom namo:CrossValidationMethodEnum ;
            owl:onProperty namo:cv_method ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:integer ;
            owl:onProperty namo:n_folds ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty namo:cv_score ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty namo:cv_std ],
        linkml:ClassDefinition ;
    skos:definition "Cross-validation strategy and results for ML models." ;
    skos:inScheme <https://w3id.org/monarch-initiative/namo> .

namo:DoseResponseSimilarity a owl:Class ;
    rdfs:label "DoseResponseSimilarity" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty namo:ec50_ratio ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty namo:correlation_coefficient ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:float ;
            owl:onProperty namo:max_response_ratio ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty namo:max_response_ratio ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty namo:correlation_coefficient ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty namo:compound_tested ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:float ;
            owl:onProperty namo:ec50_ratio ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty namo:max_response_ratio ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty namo:ec50_ratio ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty namo:compound_tested ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:float ;
            owl:onProperty namo:correlation_coefficient ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty namo:compound_tested ],
        linkml:ClassDefinition ;
    skos:definition "Comparison of dose-response relationships between model and biological systems." ;
    skos:inScheme <https://w3id.org/monarch-initiative/namo> .

namo:DrugProperties a owl:Class ;
    rdfs:label "DrugProperties" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty namo:logp ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty namo:molecular_weight ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:float ;
            owl:onProperty namo:pka ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty namo:protein_binding ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty namo:clearance ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty namo:clearance ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:float ;
            owl:onProperty namo:protein_binding ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty namo:pka ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:float ;
            owl:onProperty namo:clearance ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:float ;
            owl:onProperty namo:molecular_weight ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty namo:logp ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty namo:protein_binding ],
        [ a owl:Restriction ;
