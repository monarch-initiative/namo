    skos:definition "Sensors integrated for real-time monitoring" ;
    skos:inScheme <https://w3id.org/monarch-initiative/namo> .

namo:sensors_integrated a owl:ObjectProperty ;
    rdfs:label "sensors_integrated" ;
    skos:definition "Sensors integrated into the device for monitoring" ;
    skos:inScheme <https://w3id.org/monarch-initiative/namo> .

namo:shared_phenotypes a owl:ObjectProperty ;
    rdfs:label "shared_phenotypes" ;
    skos:definition "List of phenotypes present in both model and biological system." ;
    skos:inScheme <https://w3id.org/monarch-initiative/namo> .

namo:special_features a owl:DatatypeProperty ;
    rdfs:label "special_features" ;
    skos:definition "Additional special features of the device (e.g., valves, mixers, gradient generators)" ;
    skos:inScheme <https://w3id.org/monarch-initiative/namo> .

namo:stimulation_type a owl:ObjectProperty ;
    rdfs:label "stimulation_type" ;
    skos:definition "Type of mechanical stimulation applied" ;
    skos:inScheme <https://w3id.org/monarch-initiative/namo> .

namo:studies a owl:ObjectProperty ;
    rdfs:label "studies" ;
    skos:inScheme <https://w3id.org/monarch-initiative/namo> .

namo:surface_treatment a owl:ObjectProperty ;
    rdfs:label "surface_treatment" ;
    skos:definition "Surface treatments or coatings applied to the device" ;
    skos:inScheme <https://w3id.org/monarch-initiative/namo> .

namo:validation_datasets a owl:DatatypeProperty ;
    rdfs:label "validation_datasets" ;
    skos:definition "Datasets used for model training and validation" ;
    skos:inScheme <https://w3id.org/monarch-initiative/namo> .

namo:AnimalModel a owl:Class ;
    rdfs:label "AnimalModel" ;
    rdfs:seeAlso <https://doi.org/10.1371/journal.pbio.3000410> ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty namo:strain ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty namo:age_value ],
        [ a owl:Restriction ;
            owl:allValuesFrom namo:QuantityValue ;
            owl:onProperty namo:age_value ],
        [ a owl:Restriction ;
            owl:allValuesFrom namo:OrganismTaxon ;
            owl:onProperty namo:strain ],
        [ a owl:Restriction ;
            owl:allValuesFrom namo:OrganismTaxon ;
            owl:onProperty namo:species ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty namo:species ],
        [ a owl:Restriction ;
            owl:allValuesFrom namo:EnvironmentalExposure ;
            owl:onProperty namo:environment ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty namo:life_stage ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty namo:species ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty namo:strain ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty namo:environment ],
        [ a owl:Restriction ;
            owl:allValuesFrom namo:LifeStage ;
            owl:onProperty namo:life_stage ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty namo:environment ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty namo:age_value ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty namo:life_stage ],
        namo:ModelSystem ;
    skos:exactMatch ARRIVE:animal_model ;
    skos:inScheme <https://w3id.org/monarch-initiative/namo> .

namo:BiologicalSystem a owl:Class ;
    rdfs:label "BiologicalSystem" ;
    rdfs:subClassOf namo:NamedThing ;
    skos:inScheme <https://w3id.org/monarch-initiative/namo> .

namo:CellTypeCoverage a owl:Class ;
    rdfs:label "CellTypeCoverage" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty namo:single_cell_method ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty namo:represented_cell_types ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty namo:single_cell_method ],
        [ a owl:Restriction ;
            owl:allValuesFrom namo:Cell ;
            owl:onProperty namo:missing_cell_types ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty namo:single_cell_method ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty namo:coverage_percentage ],
        [ a owl:Restriction ;
            owl:allValuesFrom namo:Cell ;
            owl:onProperty namo:represented_cell_types ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:float ;
            owl:onProperty namo:coverage_percentage ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty namo:missing_cell_types ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty namo:cell_type_proportions ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty namo:coverage_percentage ],
        [ a owl:Restriction ;
            owl:allValuesFrom namo:CellTypeProportion ;
            owl:onProperty namo:cell_type_proportions ],
        namo:NamedThing ;
    skos:definition "Assessment of cell type representation and cellular diversity between systems." ;
    skos:inScheme <https://w3id.org/monarch-initiative/namo> .

namo:CoCulture a owl:Class ;
    rdfs:label "CoCulture" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty namo:interaction_mechanisms ],
        [ a owl:Restriction ;
            owl:allValuesFrom namo:CellRatio ;
            owl:onProperty namo:cell_ratios ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty namo:cell_ratios ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty namo:coculture_configuration ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty namo:interaction_mechanisms ],
        [ a owl:Restriction ;
            owl:allValuesFrom namo:CocultureConfigurationEnum ;
            owl:onProperty namo:coculture_configuration ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty namo:coculture_configuration ],
        namo:CellularSystem ;
    skos:definition "Co-culture systems combining multiple cell types to mimic  microenvironments and cell-cell interactions." ;
    skos:inScheme <https://w3id.org/monarch-initiative/namo> .

namo:DigitalTwin a owl:Class ;
    rdfs:label "DigitalTwin" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty namo:personalization_parameters ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty namo:real_time_data_sources ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty namo:twin_scope ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty namo:personalization_parameters ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty namo:update_frequency ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty namo:update_frequency ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty namo:real_time_data_sources ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty namo:update_frequency ],
        [ a owl:Restriction ;
            owl:allValuesFrom namo:DigitalTwinScopeEnum ;
            owl:onProperty namo:twin_scope ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty namo:twin_scope ],
        namo:InSilicoModel ;
    skos:definition "Computational replicas of biological systems for real-time prediction and personalized modeling." ;
    skos:inScheme <https://w3id.org/monarch-initiative/namo> .

namo:FunctionalAssay a owl:Class ;
    rdfs:label "FunctionalAssay" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty namo:units ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty namo:reference_value ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:float ;
            owl:onProperty namo:assay_result ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty namo:methodology ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty namo:reference_value ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty namo:assay_type ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty namo:assay_result ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty namo:methodology ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty namo:assay_type ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:float ;
            owl:onProperty namo:reference_value ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty namo:methodology ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty namo:units ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty namo:units ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty namo:assay_type ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty namo:assay_result ],
        namo:NamedThing ;
    skos:definition "A functional assay used to assess biological capabilities." ;
    skos:inScheme <https://w3id.org/monarch-initiative/namo> .

namo:FunctionalParity a owl:Class ;
    rdfs:label "FunctionalParity" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty namo:conserved_functions ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty namo:dose_response_similarity ],
        [ a owl:Restriction ;
            owl:allValuesFrom namo:FunctionalAssay ;
            owl:onProperty namo:functional_assays ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty namo:dose_response_similarity ],
        [ a owl:Restriction ;
            owl:allValuesFrom namo:DoseResponseSimilarity ;
            owl:onProperty namo:dose_response_similarity ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty namo:functional_similarity_score ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty namo:functional_assays ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty namo:functional_similarity_score ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty namo:impaired_functions ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty namo:impaired_functions ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty namo:conserved_functions ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:float ;
            owl:onProperty namo:functional_similarity_score ],
        namo:NamedThing ;
    skos:definition "Evaluation of functional capabilities and physiological responses between systems." ;
    skos:inScheme <https://w3id.org/monarch-initiative/namo> .

namo:MLModel a owl:Class ;
    rdfs:label "MLModel" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty namo:training_data_size ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty namo:feature_types ],
        [ a owl:Restriction ;
            owl:allValuesFrom namo:MLAlgorithmEnum ;
            owl:onProperty namo:ml_algorithm ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty namo:model_interpretability ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty namo:ml_algorithm ],
        [ a owl:Restriction ;
            owl:allValuesFrom namo:InterpretabilityLevelEnum ;
            owl:onProperty namo:model_interpretability ],
        [ a owl:Restriction ;
            owl:allValuesFrom namo:CrossValidation ;
            owl:onProperty namo:cross_validation ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty namo:cross_validation ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty namo:model_interpretability ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty namo:training_data_size ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:integer ;
            owl:onProperty namo:training_data_size ],
        [ a owl:Restriction ;
            owl:allValuesFrom namo:FeatureTypeEnum ;
            owl:onProperty namo:feature_types ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty namo:ml_algorithm ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty namo:cross_validation ],
        namo:InSilicoModel ;
    skos:definition "Machine Learning and AI-based models for prediction, mechanism inference, and hypothesis generation." ;
    skos:inScheme <https://w3id.org/monarch-initiative/namo> .

namo:MechanicalStimulation a owl:Class ;
    rdfs:label "MechanicalStimulation" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty namo:pressure_pascal ],
