namo:Organoid a owl:Class ;
    rdfs:label "Organoid" ;
    rdfs:seeAlso <https://doi.org/10.3390/jdb10010007> ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty namo:differentiation_method ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty namo:differentiation_method ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty namo:differentiation_method ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty namo:culture_system ],
        [ a owl:Restriction ;
            owl:allValuesFrom namo:GrossAnatomicalStructure ;
            owl:onProperty namo:organ_modeled ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty namo:organ_modeled ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty namo:culture_system ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty namo:culture_system ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty namo:organ_modeled ],
        namo:ThreeDCellCulture ;
    skos:definition "A 3D cell culture system that self-organizes to recapitulate key structural and functional aspects of an organ or tissue" ;
    skos:exactMatch MISpheroID:organoid,
        MISpheroID:spheroid ;
    skos:inScheme <https://w3id.org/monarch-initiative/namo> .

