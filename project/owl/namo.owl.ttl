    rdfs:label "rmse" ;
    skos:definition "Root mean square error" ;
    skos:inScheme <https://w3id.org/monarch-initiative/namo> .

namo:sensitivity a owl:DatatypeProperty ;
    rdfs:label "sensitivity" ;
    skos:definition "Sensitivity/recall of the model (0.0-1.0)" ;
    skos:inScheme <https://w3id.org/monarch-initiative/namo> .

namo:shear_stress a owl:DatatypeProperty ;
    rdfs:label "shear_stress" ;
    skos:definition "Shear stress applied in dyn/cm²" ;
    skos:inScheme <https://w3id.org/monarch-initiative/namo> .

namo:similarity_score a owl:DatatypeProperty ;
    rdfs:label "similarity_score" ;
    skos:definition "Quantitative similarity score (0.0-1.0) based on molecular profiles." ;
    skos:inScheme <https://w3id.org/monarch-initiative/namo> .

namo:single_cell_method a owl:DatatypeProperty ;
    rdfs:label "single_cell_method" ;
    skos:definition "Method used for single-cell analysis (e.g., scRNA-seq, flow cytometry)." ;
    skos:inScheme <https://w3id.org/monarch-initiative/namo> .

namo:size_range a owl:DatatypeProperty ;
    rdfs:label "size_range" ;
    skos:definition "Typical size range of 3D structures" ;
    skos:inScheme <https://w3id.org/monarch-initiative/namo> .

namo:software_platform a owl:DatatypeProperty ;
    rdfs:label "software_platform" ;
    skos:definition "Software platform or programming language used" ;
    skos:inScheme <https://w3id.org/monarch-initiative/namo> .

namo:spatial_context a owl:DatatypeProperty ;
    rdfs:label "spatial_context" ;
    skos:definition "Description of spatial organization and context captured by the model" ;
    skos:inScheme <https://w3id.org/monarch-initiative/namo> .

namo:species a owl:ObjectProperty ;
    rdfs:label "species" ;
    skos:definition "The species of the animal used in the model system." ;
    skos:inScheme <https://w3id.org/monarch-initiative/namo> .

namo:species_modeled a owl:ObjectProperty ;
    rdfs:label "species_modeled" ;
    skos:definition "Species for which the model is designed" ;
    skos:inScheme <https://w3id.org/monarch-initiative/namo> .

namo:specificity a owl:DatatypeProperty ;
    rdfs:label "specificity" ;
    skos:definition "Specificity of the model (0.0-1.0)" ;
    skos:inScheme <https://w3id.org/monarch-initiative/namo> .

namo:statistical_significance a owl:ObjectProperty ;
    rdfs:label "statistical_significance" ;
    skos:definition "Statistical measures of significance for the molecular similarity." ;
    skos:inScheme <https://w3id.org/monarch-initiative/namo> .

namo:statistical_test a owl:DatatypeProperty ;
    rdfs:label "statistical_test" ;
    skos:definition "Name of statistical test used." ;
    skos:inScheme <https://w3id.org/monarch-initiative/namo> .

namo:strain a owl:ObjectProperty ;
    rdfs:label "strain" ;
    skos:definition "The specific strain of the animal used in the model system. Deliberately unconstrained beyond the class: LinkML dynamic enums cannot filter by taxonomic rank, so any NCBITaxon-rooted enum would be indistinguishable from SpeciesEnum." ;
    skos:inScheme <https://w3id.org/monarch-initiative/namo> .

namo:structured_concordance a owl:ObjectProperty ;
    rdfs:label "structured_concordance" ;
    skos:definition "Detailed structured assessment of concordance between the model system and the biological system, with rich metadata and supporting evidence." ;
    skos:inScheme <https://w3id.org/monarch-initiative/namo> .

namo:substrate_type a owl:DatatypeProperty ;
    rdfs:label "substrate_type" ;
    skos:definition "Type of culture substrate (e.g., plastic, glass, coated surfaces)" ;
    skos:inScheme <https://w3id.org/monarch-initiative/namo> .

namo:three_d_architecture a owl:ObjectProperty ;
    rdfs:label "three_d_architecture" ;
    skos:definition "Type of 3D architecture (spheroid, organoid, scaffold-based, etc.)" ;
    skos:inScheme <https://w3id.org/monarch-initiative/namo> .

namo:threshold a owl:DatatypeProperty ;
    rdfs:label "threshold" ;
    skos:definition "Acceptable threshold for this metric." ;
    skos:inScheme <https://w3id.org/monarch-initiative/namo> .

namo:tissue_architecture a owl:DatatypeProperty ;
    rdfs:label "tissue_architecture" ;
    skos:definition "Description of tissue-level architecture and organization" ;
    skos:inScheme <https://w3id.org/monarch-initiative/namo> .

namo:title a owl:DatatypeProperty ;
    rdfs:label "title" ;
    skos:definition "Title of the referenced publication or dataset" ;
    skos:inScheme <https://w3id.org/monarch-initiative/namo> .

namo:training_data_size a owl:DatatypeProperty ;
    rdfs:label "training_data_size" ;
    skos:definition "Size of training dataset" ;
    skos:inScheme <https://w3id.org/monarch-initiative/namo> .

namo:training_dataset_size a owl:DatatypeProperty ;
    rdfs:label "training_dataset_size" ;
    skos:definition "Number of compounds in training dataset" ;
    skos:inScheme <https://w3id.org/monarch-initiative/namo> .

namo:twin_scope a owl:ObjectProperty ;
    rdfs:label "twin_scope" ;
    skos:definition "Scope of digital twin (organ, patient, population)" ;
    skos:inScheme <https://w3id.org/monarch-initiative/namo> .

namo:units a owl:DatatypeProperty ;
    rdfs:label "units" ;
    skos:definition "Units of measurement for the assay result." ;
    skos:inScheme <https://w3id.org/monarch-initiative/namo> .

namo:update_frequency a owl:DatatypeProperty ;
    rdfs:label "update_frequency" ;
    skos:definition "Frequency of model updates based on new data" ;
    skos:inScheme <https://w3id.org/monarch-initiative/namo> .

namo:url a owl:DatatypeProperty ;
    rdfs:label "url" ;
    skos:definition "URL to access the publication" ;
    skos:inScheme <https://w3id.org/monarch-initiative/namo> .

namo:volume a owl:DatatypeProperty ;
    rdfs:label "volume" ;
    skos:definition "Volume of the compartment (L)" ;
    skos:inScheme <https://w3id.org/monarch-initiative/namo> .

namo:width a owl:DatatypeProperty ;
    rdfs:label "width" ;
    skos:definition "Width of the channel in micrometers" ;
    skos:inScheme <https://w3id.org/monarch-initiative/namo> .

namo:year a owl:DatatypeProperty ;
    rdfs:label "year" ;
    skos:definition "Publication year" ;
    skos:inScheme <https://w3id.org/monarch-initiative/namo> .

namo:ComplexityLevelEnum a owl:Class ;
    rdfs:label "ComplexityLevelEnum" ;
    rdfs:subClassOf linkml:EnumDefinition ;
    owl:unionOf ( <https://w3id.org/monarch-initiative/namo/ComplexityLevelEnum#LOW> <https://w3id.org/monarch-initiative/namo/ComplexityLevelEnum#MODERATE> <https://w3id.org/monarch-initiative/namo/ComplexityLevelEnum#HIGH> ) ;
    skos:inScheme <https://w3id.org/monarch-initiative/namo> ;
    linkml:permissible_values <https://w3id.org/monarch-initiative/namo/ComplexityLevelEnum#HIGH>,
        <https://w3id.org/monarch-initiative/namo/ComplexityLevelEnum#LOW>,
        <https://w3id.org/monarch-initiative/namo/ComplexityLevelEnum#MODERATE> .

namo:Gene a owl:Class ;
    rdfs:label "Gene" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty namo:entrez_id ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty namo:adjusted_p_value ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty namo:p_value ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty namo:gene_symbol ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty namo:gene_symbol ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty namo:ensembl_id ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty namo:fold_change ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:float ;
            owl:onProperty namo:p_value ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:float ;
            owl:onProperty namo:fold_change ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty namo:gene_symbol ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:integer ;
            owl:onProperty namo:entrez_id ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty namo:entrez_id ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty namo:fold_change ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty namo:ensembl_id ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty namo:ensembl_id ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:float ;
            owl:onProperty namo:adjusted_p_value ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty namo:adjusted_p_value ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty namo:p_value ],
        namo:NamedThing ;
    skos:definition "A gene entity with identifiers and expression information." ;
    skos:inScheme <https://w3id.org/monarch-initiative/namo> .

namo:GrossAnatomicalStructure a owl:Class ;
    rdfs:label "GrossAnatomicalStructure" ;
    rdfs:subClassOf namo:BiolinkEntity ;
    skos:definition "An anatomical structure that has more than one cell as a part." ;
    skos:exactMatch biolink:GrossAnatomicalStructure ;
    skos:inScheme <https://w3id.org/monarch-initiative/namo> .

namo:OrganismTaxon a owl:Class ;
    rdfs:label "OrganismTaxon" ;
    rdfs:subClassOf namo:BiolinkEntity ;
    skos:definition "A classification of a set of organisms. Can also be used to represent strains or subspecies." ;
    skos:exactMatch biolink:OrganismTaxon ;
    skos:inScheme <https://w3id.org/monarch-initiative/namo> .

namo:Pathway a owl:Class ;
    rdfs:label "Pathway" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty namo:pathway_id ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty namo:enrichment_score ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty namo:pathway_id ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty namo:activity_score ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty namo:activity_score ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty namo:pathway_database ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty namo:pathway_database ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty namo:pathway_id ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:float ;
            owl:onProperty namo:activity_score ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:float ;
            owl:onProperty namo:enrichment_score ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty namo:pathway_database ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty namo:enrichment_score ],
        namo:NamedThing ;
    skos:definition "A biological pathway with activity and enrichment information." ;
    skos:inScheme <https://w3id.org/monarch-initiative/namo> .

namo:PhenotypicFeature a owl:Class ;
    rdfs:label "PhenotypicFeature" ;
    rdfs:subClassOf namo:BiolinkEntity ;
    skos:definition "A combination of entity and quality that makes up a phenotyping statement." ;
    skos:exactMatch biolink:PhenotypicFeature ;
    skos:inScheme <https://w3id.org/monarch-initiative/namo> .

namo:PredictionOutcomeEnum a owl:Class ;
    rdfs:label "PredictionOutcomeEnum" ;
    rdfs:subClassOf linkml:EnumDefinition ;
    owl:unionOf ( <https://w3id.org/monarch-initiative/namo/PredictionOutcomeEnum#TP> <https://w3id.org/monarch-initiative/namo/PredictionOutcomeEnum#FP> <https://w3id.org/monarch-initiative/namo/PredictionOutcomeEnum#TN> <https://w3id.org/monarch-initiative/namo/PredictionOutcomeEnum#FN> ) ;
    skos:inScheme <https://w3id.org/monarch-initiative/namo> ;
    linkml:permissible_values <https://w3id.org/monarch-initiative/namo/PredictionOutcomeEnum#FN>,
        <https://w3id.org/monarch-initiative/namo/PredictionOutcomeEnum#FP>,
        <https://w3id.org/monarch-initiative/namo/PredictionOutcomeEnum#TN>,
        <https://w3id.org/monarch-initiative/namo/PredictionOutcomeEnum#TP> .

namo:PresenceEnum a owl:Class ;
    rdfs:label "PresenceEnum" ;
    rdfs:subClassOf linkml:EnumDefinition ;
    owl:unionOf ( <https://w3id.org/monarch-initiative/namo/PresenceEnum#PRESENT> <https://w3id.org/monarch-initiative/namo/PresenceEnum#ABSENT> <https://w3id.org/monarch-initiative/namo/PresenceEnum#BELOW_DETECTION_LIMIT> <https://w3id.org/monarch-initiative/namo/PresenceEnum#ABOVE_DETECTION_LIMIT> ) ;
    skos:inScheme <https://w3id.org/monarch-initiative/namo> ;
    linkml:permissible_values <https://w3id.org/monarch-initiative/namo/PresenceEnum#ABOVE_DETECTION_LIMIT>,
        <https://w3id.org/monarch-initiative/namo/PresenceEnum#ABSENT>,
        <https://w3id.org/monarch-initiative/namo/PresenceEnum#BELOW_DETECTION_LIMIT>,
        <https://w3id.org/monarch-initiative/namo/PresenceEnum#PRESENT> .

namo:RatioTypeEnum a owl:Class ;
    rdfs:label "RatioTypeEnum" ;
    rdfs:subClassOf linkml:EnumDefinition ;
    owl:unionOf ( <https://w3id.org/monarch-initiative/namo/RatioTypeEnum#PERCENTAGE> <https://w3id.org/monarch-initiative/namo/RatioTypeEnum#ABSOLUTE> <https://w3id.org/monarch-initiative/namo/RatioTypeEnum#FOLD> ) ;
    skos:inScheme <https://w3id.org/monarch-initiative/namo> ;
    linkml:permissible_values <https://w3id.org/monarch-initiative/namo/RatioTypeEnum#ABSOLUTE>,
        <https://w3id.org/monarch-initiative/namo/RatioTypeEnum#FOLD>,
        <https://w3id.org/monarch-initiative/namo/RatioTypeEnum#PERCENTAGE> .

namo:ThreeDCellCulture a owl:Class ;
    rdfs:label "ThreeDCellCulture" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty namo:three_d_architecture ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty namo:three_d_architecture ],
        [ a owl:Restriction ;
            owl:allValuesFrom namo:ThreeDArchitectureEnum ;
            owl:onProperty namo:three_d_architecture ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty namo:size_range ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty namo:matrix_composition ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty namo:matrix_composition ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty namo:size_range ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty namo:matrix_composition ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty namo:size_range ],
        namo:CellularSystem ;
    skos:definition "Three-dimensional cell culture systems including spheroids and organoids. More physiologically relevant with 3D architecture." ;
    skos:inScheme <https://w3id.org/monarch-initiative/namo> .

namo:TwoDCellCulture a owl:Class ;
    rdfs:label "TwoDCellCulture" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom xsd:float ;
            owl:onProperty namo:confluence_level ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty namo:confluence_level ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty namo:substrate_type ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty namo:passage_protocol ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty namo:confluence_level ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty namo:substrate_type ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty namo:passage_protocol ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty namo:passage_protocol ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty namo:substrate_type ],
        namo:CellularSystem ;
    skos:definition "Conventional monolayer cell cultures grown on flat surfaces. Simple but limited in physiological relevance." ;
    skos:inScheme <https://w3id.org/monarch-initiative/namo> .

namo:cell_types a owl:ObjectProperty .

namo:InterpretabilityLevelEnum a owl:Class ;
    rdfs:label "InterpretabilityLevelEnum" ;
    rdfs:subClassOf linkml:EnumDefinition ;
    owl:unionOf ( <https://w3id.org/monarch-initiative/namo/InterpretabilityLevelEnum#BLACK_BOX> <https://w3id.org/monarch-initiative/namo/InterpretabilityLevelEnum#INTERPRETABLE> <https://w3id.org/monarch-initiative/namo/InterpretabilityLevelEnum#EXPLAINABLE> <https://w3id.org/monarch-initiative/namo/InterpretabilityLevelEnum#CAUSAL> ) ;
    skos:inScheme <https://w3id.org/monarch-initiative/namo> ;
    linkml:permissible_values <https://w3id.org/monarch-initiative/namo/InterpretabilityLevelEnum#BLACK_BOX>,
        <https://w3id.org/monarch-initiative/namo/InterpretabilityLevelEnum#CAUSAL>,
        <https://w3id.org/monarch-initiative/namo/InterpretabilityLevelEnum#EXPLAINABLE>,
        <https://w3id.org/monarch-initiative/namo/InterpretabilityLevelEnum#INTERPRETABLE> .

namo:MicrophysiologicalSystem a owl:Class ;
    rdfs:label "MicrophysiologicalSystem" ;
    rdfs:seeAlso <https://www.iso.org/standard/74157.html> ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom namo:MicrofluidicDesign ;
            owl:onProperty namo:microfluidic_design ],
        [ owl:unionOf ( namo:OrganOnChip namo:TissueOnChip ) ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty namo:microfluidic_design ],
        [ a owl:Restriction ;
            owl:allValuesFrom namo:IntegratedSensorEnum ;
            owl:onProperty namo:sensor_integration ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty namo:mechanical_forces ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty namo:microfluidic_design ],
        [ a owl:Restriction ;
            owl:allValuesFrom namo:MechanicalStimulation ;
            owl:onProperty namo:mechanical_forces ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty namo:perfusion_system ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty namo:perfusion_system ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty namo:mechanical_forces ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty namo:sensor_integration ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty namo:perfusion_system ],
        namo:NAMModel ;
    skos:definition "Organ-/tissue-on-chip systems that integrate microfluidics, biomaterials, and living cells to replicate tissue-level physiology and dynamics. Conforms to ISO 22916:2022 interoperability requirements for dimensions, connections, and device classification." ;
    skos:exactMatch ISO22916:microfluidic_device ;
    skos:inScheme <https://w3id.org/monarch-initiative/namo> .

namo:ModelSystem a owl:Class ;
    rdfs:label "ModelSystem" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty namo:models ],
        [ owl:unionOf ( namo:AnimalModel namo:NAMModel ) ],
        [ a owl:Restriction ;
            owl:allValuesFrom namo:ModelsRelationship ;
            owl:onProperty namo:models ],
        namo:NamedThing ;
    skos:inScheme <https://w3id.org/monarch-initiative/namo> .

namo:BiolinkEntity a owl:Class ;
    rdfs:label "BiolinkEntity" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty namo:id ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty namo:name ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty namo:description ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty namo:description ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty namo:name ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty namo:name ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty namo:id ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:anyURI ;
            owl:onProperty namo:id ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty namo:description ],
        [ owl:unionOf ( namo:Cell namo:EnvironmentalExposure namo:GrossAnatomicalStructure namo:LifeStage namo:OrganismTaxon namo:PhenotypicFeature ) ],
        linkml:ClassDefinition ;
    skos:definition "Abstract parent for NAMO classes that stand in for a class in the Biolink Model." ;
    skos:inScheme <https://w3id.org/monarch-initiative/namo> .

namo:CellularSystem a owl:Class ;
    rdfs:label "CellularSystem" ;
    rdfs:seeAlso <https://doi.org/10.5966/sctm.2015-0393> ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty namo:culture_conditions ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty namo:culture_conditions ],
        [ a owl:Restriction ;
            owl:allValuesFrom namo:Cell ;
            owl:onProperty namo:cell_types ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty namo:cell_types ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty namo:culture_conditions ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty namo:cell_source ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty namo:cell_source ],
        [ owl:unionOf ( namo:CoCulture namo:ThreeDCellCulture namo:TwoDCellCulture ) ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty namo:cell_source ],
        namo:NAMModel ;
    skos:definition "Cell-based model systems that use living cells to model biological processes. Includes 2D cultures, 3D systems, and co-cultures. Conforms to MIACA (Minimal Information About a Cellular Assay) standards." ;
    skos:exactMatch MIACA:cellular_assay ;
    skos:inScheme <https://w3id.org/monarch-initiative/namo> .

namo:CocultureConfigurationEnum a owl:Class ;
    rdfs:label "CocultureConfigurationEnum" ;
    rdfs:subClassOf linkml:EnumDefinition ;
    owl:unionOf ( <https://w3id.org/monarch-initiative/namo/CocultureConfigurationEnum#DIRECT_CONTACT> <https://w3id.org/monarch-initiative/namo/CocultureConfigurationEnum#TRANSWELL> <https://w3id.org/monarch-initiative/namo/CocultureConfigurationEnum#CONDITIONED_MEDIA> <https://w3id.org/monarch-initiative/namo/CocultureConfigurationEnum#MICROPATTERN> <https://w3id.org/monarch-initiative/namo/CocultureConfigurationEnum#GRADIENT> ) ;
