namo:active_pathways a owl:ObjectProperty ;
    rdfs:label "active_pathways" ;
    skos:definition "List of biological pathways that are active in both systems." ;
    skos:inScheme <https://w3id.org/monarch-initiative/namo> .

namo:authors a owl:DatatypeProperty ;
    rdfs:label "authors" ;
    skos:definition "Authors of the publication" ;
    skos:inScheme <https://w3id.org/monarch-initiative/namo> .

namo:barrier_functions a owl:DatatypeProperty ;
    rdfs:label "barrier_functions" ;
    skos:definition "Tissue barrier functions modeled (epithelial, endothelial, etc.)" ;
    skos:inScheme <https://w3id.org/monarch-initiative/namo> .

namo:biological_specific_phenotypes a owl:ObjectProperty ;
    rdfs:label "biological_specific_phenotypes" ;
    skos:definition "List of phenotypes present only in the biological system." ;
    skos:inScheme <https://w3id.org/monarch-initiative/namo> .

namo:cell_ratios a owl:ObjectProperty ;
    rdfs:label "cell_ratios" ;
    skos:definition "Ratios of different cell types in the co-culture" ;
    skos:inScheme <https://w3id.org/monarch-initiative/namo> .

namo:cell_type_proportions a owl:ObjectProperty ;
    rdfs:label "cell_type_proportions" ;
    skos:definition "Quantitative comparison of cell type proportions." ;
    skos:inScheme <https://w3id.org/monarch-initiative/namo> .

namo:channel_configuration a owl:ObjectProperty ;
    rdfs:label "channel_configuration" ;
    skos:definition "Configuration of channels (e.g., parallel, serial, branching)" ;
    skos:inScheme <https://w3id.org/monarch-initiative/namo> .

namo:channel_dimensions a owl:ObjectProperty ;
    rdfs:label "channel_dimensions" ;
    skos:definition "Dimensions of the channels in the device" ;
    skos:inScheme <https://w3id.org/monarch-initiative/namo> .

namo:compartments a owl:ObjectProperty ;
    rdfs:label "compartments" ;
    skos:definition "Physiological compartments included in the model" ;
    skos:inScheme <https://w3id.org/monarch-initiative/namo> .

namo:conserved_functions a owl:DatatypeProperty ;
    rdfs:label "conserved_functions" ;
    skos:definition "List of biological functions conserved between model and biological system." ;
    skos:inScheme <https://w3id.org/monarch-initiative/namo> .

namo:conserved_genes a owl:ObjectProperty ;
    rdfs:label "conserved_genes" ;
    skos:definition "List of genes with conserved expression patterns between model and target." ;
    skos:inScheme <https://w3id.org/monarch-initiative/namo> .

namo:differentially_expressed_genes a owl:ObjectProperty ;
    rdfs:label "differentially_expressed_genes" ;
    skos:definition "List of genes that are differentially expressed in the model system." ;
    skos:inScheme <https://w3id.org/monarch-initiative/namo> .

namo:divergent_pathways a owl:ObjectProperty ;
    rdfs:label "divergent_pathways" ;
    skos:definition "List of pathways that show different activity patterns." ;
    skos:inScheme <https://w3id.org/monarch-initiative/namo> .

namo:elimination_pathways a owl:DatatypeProperty ;
    rdfs:label "elimination_pathways" ;
    skos:definition "Drug elimination and metabolism pathways included" ;
    skos:inScheme <https://w3id.org/monarch-initiative/namo> .

namo:enrichment_statistics a owl:ObjectProperty ;
    rdfs:label "enrichment_statistics" ;
    skos:definition "Statistical measures of pathway enrichment." ;
    skos:inScheme <https://w3id.org/monarch-initiative/namo> .

namo:feature_types a owl:ObjectProperty ;
    rdfs:label "feature_types" ;
    skos:definition "Types of features used (molecular, phenotypic, imaging, etc.)" ;
    skos:inScheme <https://w3id.org/monarch-initiative/namo> .

namo:flow_control_method a owl:ObjectProperty ;
    rdfs:label "flow_control_method" ;
    skos:definition "Methods used to control fluid flow in the device" ;
    skos:inScheme <https://w3id.org/monarch-initiative/namo> .

namo:functional_assays a owl:ObjectProperty ;
    rdfs:label "functional_assays" ;
    skos:definition "List of functional assays used to assess parity." ;
    skos:inScheme <https://w3id.org/monarch-initiative/namo> .

namo:impaired_functions a owl:DatatypeProperty ;
    rdfs:label "impaired_functions" ;
    skos:definition "List of functions that are impaired or absent in the model system." ;
    skos:inScheme <https://w3id.org/monarch-initiative/namo> .

namo:interaction_mechanisms a owl:DatatypeProperty ;
    rdfs:label "interaction_mechanisms" ;
