namo:NAMModel a owl:Class ;
    rdfs:label "NAMModel" ;
    rdfs:seeAlso <https://doi.org/10.14573/altex.2501011> ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty namo:references ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty namo:spatial_context ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty namo:spatial_context ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty namo:complexity_level ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty namo:complexity_level ],
        [ a owl:Restriction ;
            owl:allValuesFrom namo:BiologicalOrganizationLevelEnum ;
            owl:onProperty namo:biological_organization_level ],
        [ a owl:Restriction ;
            owl:allValuesFrom namo:ComplexityLevelEnum ;
            owl:onProperty namo:complexity_level ],
        [ a owl:Restriction ;
            owl:allValuesFrom namo:Reference ;
            owl:onProperty namo:references ],
        [ owl:unionOf ( namo:CellularSystem namo:InSilicoModel namo:MicrophysiologicalSystem ) ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty namo:biological_organization_level ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty namo:biological_organization_level ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty namo:spatial_context ],
        namo:ModelSystem ;
    skos:definition "A New Approach Methodology (NAM) model, which is a type of model system that does not involve the use of animals." ;
    skos:exactMatch GIVReST:in_vitro_model,
        OECD:new_approach_methodology ;
    skos:inScheme <https://w3id.org/monarch-initiative/namo> .

