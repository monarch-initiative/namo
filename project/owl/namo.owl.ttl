            owl:onProperty namo:pass_fail_status ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty namo:pass_fail_status ],
        linkml:ClassDefinition ;
    skos:definition "A quality control measure and its associated value." ;
    skos:inScheme <https://w3id.org/monarch-initiative/namo> .

namo:QuantityValue a owl:Class ;
    rdfs:label "QuantityValue" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty namo:has_numeric_value ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:anyURI ;
            owl:onProperty namo:has_unit ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:double ;
            owl:onProperty namo:has_numeric_value ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty namo:has_unit ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty namo:has_unit ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty namo:has_numeric_value ],
        linkml:ClassDefinition ;
    skos:definition "A value of an attribute that is quantitative and measurable, expressed as a combination of a unit and a numeric value. Biolink models this as an annotation rather than a named thing, so it has no identifier and is inlined by value." ;
    skos:exactMatch biolink:QuantityValue ;
    skos:inScheme <https://w3id.org/monarch-initiative/namo> .

